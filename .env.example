# --- Database (PostgreSQL 14+; Supabase, Neon, RDS or self-hosted) ---
DATABASE_URL=postgres://sardar:sardar@localhost:5432/sardar
# Set to "true" for hosted Postgres that requires TLS (Supabase, Neon, RDS).
DATABASE_SSL=false
# Set to "false" when connecting through a transaction pooler (Supabase port 6543 / PgBouncer).
DATABASE_PREPARE=true

# --- Public site URL (used for canonical URLs, sitemap, Open Graph, emails) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Security ---
# Long random string used to hash visitor IPs for rate limiting. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# --- Email (optional). Without SMTP, enquiries & quotes are still saved and
#     staff can share quotes by WhatsApp/email links from the dashboard. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Sardar Travels <bookings@example.com>"
# Where new-enquiry notifications go (comma separated).
STAFF_NOTIFY_EMAILS=

# --- Analytics (optional). Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
#     When empty, no analytics script loads and no cookie banner is shown. ---
NEXT_PUBLIC_GA_ID=
